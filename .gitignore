# Training, evaluation, and visualization outputs (repository root only)
/output/
/output_*/
/instant_test_output/
/inference_test_output/
/runs/
/tensorboard/

# Python bytecode, native extensions, and build artifacts
__pycache__/
*.py[cod]
*$py.class
_ext/
*.pyd
*.so
*.egg-info/
build/
dist/
wheels/

# Local Python/Conda environments
.venv/
venv/
env/
.conda/
.python-version

# Model checkpoints and generated binary data
*.pth
*.pt
*.ckpt
*.safetensors
*.bin
*.onnx
*.engine
*.torchscript
*.tflite
*.pkl
*.npy

# Jupyter runtime files; notebooks themselves may be committed
**/.ipynb_checkpoints/

# Editor, OS, and temporary files
*.swn
*.swo
*.swp
*~
.idea/
.vscode/
_darcs/
.DS_Store
Thumbs.db

# Upstream/local dataset locations
/datasets/*
!/datasets/*.*
/projects/*/datasets/

# Repository-specific datasets and downloaded pretrained weights
/panda_coco_data/
/SAR_COCO_ship/
/SAR_COCO/
/LPI_COCO/
/ship_dataset_v0/
/lwb_models/

# Experiment tracking, test output, and caches
/wandb/
/mlruns/
/lightning_logs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
coverage.xml
htmlcov/

# Local secrets; keep an intentionally sanitized example if one is added
.env
.env.*
!.env.example
*.pem
*.key

# Downloaded archives
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
